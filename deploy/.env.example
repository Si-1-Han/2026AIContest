# EC2의 /opt/hansei-campus/.env 형식 예시.
# GitHub Actions 배포가 매번 이 파일을 다시 쓰므로, 값은 EC2가 아니라
# GitHub 저장소 Settings → Secrets and variables → Actions 에서 관리하세요.

# 이미지 (Actions가 채움)
IMAGE_PREFIX=ghcr.io/si-1-han/2026aicontest
IMAGE_TAG=latest

# 비우면 http://<EC2 IP>, 도메인을 넣으면 HTTPS 자동 발급   (Variables: SITE_ADDRESS)
SITE_ADDRESS=

# AI 길안내 — 없으면 규칙 기반 폴백으로 동작               (Secrets: ANTHROPIC_API_KEY)
ANTHROPIC_API_KEY=
GUIDE_MODEL=
GUIDE_DAILY_LIMIT=2000
GUIDE_RATE_PER_MIN=20

# PUT /api/v1/buildings/{id} 편집 토큰 — 비우면 비활성화    (Secrets: CAMPUS_ADMIN_TOKEN)
CAMPUS_ADMIN_TOKEN=
