# cp .env.example .env.local
# Campus API(FastAPI) 주소.
# - 개발(`npm run dev`)에서는 비워 두세요. Vite 프록시가 /api/v1을 localhost:8000으로 넘깁니다.
# - 배포 빌드에서 API를 쓰려면 주소를 넣으세요 (예: https://hansei-campus-api.onrender.com)
VITE_API_URL=

# ── 아래는 Vercel 함수(api/guide.ts)용. Vercel 프로젝트 환경변수에 설정한다. ──
# 비어 있으면 AI 대신 규칙 기반 폴백으로 응답한다.
ANTHROPIC_API_KEY=
GUIDE_MODEL=claude-haiku-5-5
